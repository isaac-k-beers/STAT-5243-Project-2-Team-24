# =============================================================================
# SERVER
server <- function(input, output, session) {

  # ------------------------------------------------------------------
  # Reactive: raw data (uploaded or built-in)
  # ------------------------------------------------------------------
  raw_data <- reactive({
    if (!is.null(input$upload_csv)) {
      read.csv(input$upload_csv$datapath, stringsAsFactors = FALSE)
    } else {
      read.csv("JC-202301-citibike-tripdata.csv", stringsAsFactors = FALSE)
    }
  })

  eng_data <- eventReactive(input$run_btn, {
    req(raw_data())
    df <- raw_data() %>% slice_sample(n = min(input$sample_n, nrow(raw_data())))
    withProgress(message = "Engineering features…", value = 0.5, {
      engineer_features(df, input$selected_feats)
    })
  }, ignoreNULL = FALSE)   # run on startup with defaults

  observe({
    isolate({ eng_data() })
  })

  observe({
    df <- eng_data()
    num_cols <- names(df)[sapply(df, is.numeric)]
    cat_cols <- names(df)[sapply(df, function(x) is.character(x) | is.factor(x))]

    updateSelectInput(session, "plot_feature",
                      choices  = intersect(num_cols, c(numeric_features, num_cols)),
                      selected = if ("trip_duration_min" %in% num_cols) "trip_duration_min" else num_cols[1])
    updateSelectInput(session, "scatter_x",
                      choices  = num_cols,
                      selected = if ("trip_duration_min" %in% num_cols) "trip_duration_min" else num_cols[1])
    updateSelectInput(session, "scatter_y",
                      choices  = num_cols,
                      selected = if ("haversine_distance_km" %in% num_cols) "haversine_distance_km" else num_cols[min(2, length(num_cols))])
  })

  # Tab 1: Feature Guide
  output$feature_guide_ui <- renderUI({
    sel <- input$selected_feats
    if (length(sel) == 0) return(p("No features selected yet."))

    tagList(
      h4("Currently selected features and their definitions:"),
      tags$table(
        class = "table table-striped table-sm",
        tags$thead(tags$tr(
          tags$th("Feature Column"),
          tags$th("Description")
        )),
        tags$tbody(
          lapply(sel, function(f) {
            tags$tr(
              tags$td(tags$code(f)),
              tags$td(feature_descriptions[f])
            )
          })
        )
      )
    )
  })

  
  # Tab 2: Data Preview
  
  output$preview_table <- renderDT({
    req(eng_data())
    datatable(
      head(eng_data(), 200),
      options  = list(scrollX = TRUE, pageLength = 15, dom = "tp"),
      rownames = FALSE
    )
  })

  # Tab 3: Distribution Plot
  output$dist_plot <- renderPlot({
    df  <- eng_data()
    feat <- input$plot_feature
    grp  <- input$plot_group
    ptype <- input$plot_type
    req(feat %in% names(df))

    # Remove extreme outliers for cleaner plots (99th percentile cap)
    cap <- quantile(df[[feat]], 0.99, na.rm = TRUE)
    df2 <- df %>% filter(.data[[feat]] <= cap, !is.na(.data[[feat]]))

    if (grp == "None" || !grp %in% names(df2)) {
      p <- ggplot(df2, aes(x = .data[[feat]]))
    } else {
      p <- ggplot(df2, aes(x = .data[[feat]], fill = .data[[grp]],
                           colour = .data[[grp]]))
    }

    p <- switch(ptype,
      "Histogram" = p + geom_histogram(bins = 40, alpha = 0.7, position = "identity"),
      "Density"   = p + geom_density(alpha = 0.5),
      "Boxplot"   = {
        if (grp != "None" && grp %in% names(df2)) {
          ggplot(df2, aes(x = .data[[grp]], y = .data[[feat]],
                          fill = .data[[grp]])) +
            geom_boxplot(alpha = 0.7, outlier.size = 0.5) +
            theme(axis.text.x = element_text(angle = 30, hjust = 1))
        } else {
          ggplot(df2, aes(y = .data[[feat]])) +
            geom_boxplot(alpha = 0.7, fill = "steelblue")
        }
      }
    )

    p + theme_minimal(base_size = 14) +
        labs(title = paste("Distribution of", feat),
             x = feat, y = "Count") +
        theme(legend.position = "bottom")
  })

  output$dist_summary <- renderPrint({
    df   <- eng_data()
    feat <- input$plot_feature
    req(feat %in% names(df))
    summary(df[[feat]])
  })

  
  # Tab 4: Scatter
  output$scatter_plot <- renderPlot({
    df  <- eng_data()
    x   <- input$scatter_x
    y   <- input$scatter_y
    col <- input$scatter_color
    req(x %in% names(df), y %in% names(df))

    # Cap outliers for better scatter
    cap_x <- quantile(df[[x]], 0.99, na.rm = TRUE)
    cap_y <- quantile(df[[y]], 0.99, na.rm = TRUE)
    df2 <- df %>%
      filter(.data[[x]] <= cap_x, .data[[y]] <= cap_y,
             !is.na(.data[[x]]), !is.na(.data[[y]])) %>%
      slice_sample(n = min(3000, nrow(.)))  # keep plot responsive

    if (col != "None" && col %in% names(df2)) {
      p <- ggplot(df2, aes(.data[[x]], .data[[y]], colour = .data[[col]]))
    } else {
      p <- ggplot(df2, aes(.data[[x]], .data[[y]]))
    }

    p + geom_point(alpha = 0.35, size = 1.2) +
        geom_smooth(method = "lm", se = FALSE, linewidth = 0.8, colour = "black") +
        theme_minimal(base_size = 14) +
        labs(title = paste(y, "vs", x),
             x = x, y = y) +
        theme(legend.position = "bottom")
  })

  
  # Tab 5: Summary Statistics
  output$summary_stats <- renderPrint({
    df <- eng_data()
    num_cols <- names(df)[sapply(df, is.numeric)]
    if (length(num_cols) == 0) {
      cat("No numeric engineered features in current selection.\n")
    } else {
      df %>% select(all_of(num_cols)) %>% summary() %>% print()
    }
  })

  # Download handler
  output$download_btn <- downloadHandler(
    filename = function() paste0("citibike_engineered_", Sys.Date(), ".csv"),
    content  = function(file) {
      write.csv(eng_data(), file, row.names = FALSE)
    }
  )
}

# Run the app
shinyApp(ui = ui, server = server)
